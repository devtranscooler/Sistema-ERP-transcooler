        .sidebar {
            background-color: #123456;
            color: white;
            width: 60px;
            height: 100vh;
            transition: width 0.3s;
            overflow: hidden;
            position: fixed;
            top: 40px;
            left: 0;
            z-index: 999;
            border-radius: 15px;
        }

        .sidebar.open {
            width: 250px;
        }

        .sidebar ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .sidebar li {
            padding: 15px;
            display: none;
            transition: background-color 0.3s, border 0.3s;
            border-radius: 10px;
        }

        .sidebar.open li {
            display: block;
            cursor: pointer;
        }

        .sidebar li:hover {
            background-color: #345678;
            border: 1px solid #ffffff;
        }

        .menu-toggle {
            background: none;
            border: none;
            color: white;
            font-size: 24px;
            cursor: pointer;
            padding: 15px;
        }

        .submenu {
            display: none;
            padding-left: 15px;
        }

        .sidebar.open .has-submenu:hover .submenu {
            display: block;
        }

        .sub-submenu {
            display: none;
            padding-left: 15px;
        }

        .submenu li:hover .sub-submenu {
            display: block;
        }

        .content {
            flex-grow: 1;
            padding: 20px;
            margin-left: 60px;
            margin-top: 50px;
            transition: margin-left 0.3s;
        }

        .sidebar.open + .content {
            margin-left: 250px;
        }
    </style>

    <script>
        function toggleMenu() {
            const sidebar = document.getElementById('sidebar');
            sidebar.classList.toggle('open');
        }

        function closeMenu(event) {
            const sidebar = document.getElementById('sidebar');
            if (sidebar.classList.contains('open') && !sidebar.contains(event.target)) {
                sidebar.classList.remove('open');
            }
        }
    </script>
</head>
